# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SQLite WAL Ledger Database Path (Node v22+ node:sqlite)
CRYPTIC_SQLITE_PATH="./storage/cryptic-ledger.sqlite"

# Local TCP Stratum v1 Server Listener Port (use 0 for OS-assigned ephemeral if busy)
STRATUM_TCP_PORT="3333"

# Stripe Connect Server-Side Credentials (Test Mode Recommended: sk_test_... / whsec_...)
# Never expose these in VITE_ variables or client bundles.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_ACCOUNT_ID=""

# Optional Wolfram / Mathematica External Symbolic Adapter
WOLFRAM_APP_ID=""
WOLFRAM_CLOUD_ENDPOINT=""

# Optional WebRTC STUN/TURN ICE Configuration (Public STUN default + optional TURN relay)
WEBRTC_STUN_URLS="stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302"
WEBRTC_TURN_URL=""
WEBRTC_TURN_USERNAME=""
WEBRTC_TURN_CREDENTIAL=""
