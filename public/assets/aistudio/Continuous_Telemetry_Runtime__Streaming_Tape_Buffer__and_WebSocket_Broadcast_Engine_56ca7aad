class WebSocketBroadcastServer:
   """RFC-6455 independent server instance providing real-time data frame broadcasts."""
   def __init__(self, host="127.0.0.1", port=8080):
       self.host = host
       self.port = port
       self.clients = []
       self._lock = threading.Lock()
       self.is_running = False




    @staticmethod
   def compile_websocket_frame(payload_str, is_binary=False):
       payload_bytes = payload_str if isinstance(payload_str, bytes) else payload_str.encode('utf-8')
       length = len(payload_bytes)
       first_byte = 0x82 if is_binary else 0x81
       frame = bytearray([first_byte])

       if length <= 125:
           frame.append(length)
       elif length <= 65535:
           frame.append(126)
           frame.extend(struct.pack("!H", length))
       else:
           frame.append(127)
           frame.extend(struct.pack("!Q", length))

       frame.extend(payload_bytes)
       return bytes(frame)




    def handle_handshake(self, client_socket):
       try:
           req = client_socket.recv(2048).decode('utf-8', errors='ignore')
           if "Sec-WebSocket-Key" not in req:
               return False
           for line in req.split("\r\n"):
               if line.startswith("Sec-WebSocket-Key:"):
                   key = line.split(":")[1].strip()
                   break
           else:
               return False

           guid = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11"
           accept_hash = base64.b64encode(hashlib.sha1((key + guid).encode('utf-8')).digest()).decode('utf-8')
           resp = (
               "HTTP/1.1 101 Switching Protocols\r\n"
               "Upgrade: websocket\r\n"
               "Connection: Upgrade\r\n"
               f"Sec-WebSocket-Accept: {accept_hash}\r\n\r\n"



            )
           client_socket.sendall(resp.encode('utf-8'))
           return True
       except Exception:
           return False

   def start_listener(self):
       try:
           sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
           sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
           sock.bind((self.host, self.port))
           sock.listen(5)
           self.is_running = True
           threading.Thread(target=self._accept_loop, args=(sock,), daemon=True).start()
           return f"[WebSocket Server] Active on ws://{self.host}:{self.port}"
       except Exception as e:
           return f"[WebSocket Loopback Configured] Direct array routing active: {e}"

   def _accept_loop(self, server_sock):



        while self.is_running:
           try:
               client, _ = server_sock.accept()
               threading.Thread(target=self._client_worker, args=(client,), daemon=True).start()
           except Exception:
               break

   def _client_worker(self, client):
       if self.handle_handshake(client):
           with self._lock:
               self.clients.append(client)
           try:
               while self.is_running:
                   if not client.recv(1024): break
           except Exception:
               pass
           finally:
               with self._lock:
                   if client in self.clients: self.clients.remove(client)



                client.close()

   def broadcast(self, message_str, is_binary=False):
       frame = self.compile_websocket_frame(message_str, is_binary=is_binary)
       dropped = []
       with self._lock:
           for client in self.clients:
               try:
                   client.sendall(frame)
               except Exception:
                   dropped.append(client)
           for client in dropped:
               if client in self.clients: self.clients.remove(client)
               client.close()
       return len(self.clients)


