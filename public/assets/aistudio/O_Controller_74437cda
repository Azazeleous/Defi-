# 3. UNBOUNDED REINFORCEMENT LEARNING & PERPETUAL CONTROLLER
# =====================================================================
class UnboundedPerpetualController:



    """
   Implements a perpetual adaptive optimization framework using extended parameter bounds Q-learning.
   Balances execution latency, compression overhead, cloud compute costs, and node power depletion.
   Optimizes: V(s) = min_a [ Cost(s,a) + gamma * sum(P(s'|s,a)V(s')) ]
   """
   def __init__(self, gamma: float = 0.95, alpha: float = 0.2):
       self.gamma = gamma
       self.alpha = alpha
       # Q-Table mapping: state tuple -> list of values corresponding to ACTIONS
       # State formulation: (Discretized_Payload_Size, Discretized_Network_Congestion, Discretized_Battery_Level)
       self.q_table: Dict[Tuple[int, int, int], List[float]] = {}
       
   def _discretize_state(self, state: Dict[str, Any]) -> Tuple[int, int, int]:
       # Quantize fluid network parameters into bounding buckets
       bytes_factor = min(4, int(math.log10(max(1, state["incoming_bytes"]))))
       congestion_factor = min(3, int(state["latency_ms"] / 50))
       power_factor = min(3, int(state["energy_expenditure_joules"] * 10))
       return (bytes_factor, congestion_factor, power_factor)




    def get_q_values(self, state_key: Tuple[int, int, int]) -> List[float]:
       if state_key not in self.q_table:
           # Initialize with standard proxy operational cost matrix weights
           self.q_table[state_key] = [10.0, 5.0, 3.0, 7.0, 8.0]
       return self.q_table[state_key]

   def choose_optimal_action(self, state: Dict[str, Any], exploration: bool = False) -> str:
       state_key = self._discretize_state(state)
       q_vals = self.get_q_values(state_key)
       
       if exploration and random.random() < 0.05:
           return random.choice(ACTIONS)
       
       # Since this formulation models cost-minimization, select the smallest cost vector
       min_idx = q_vals.index(min(q_vals))
       return ACTION_MAP[min_idx]

   def update_policy(self, state: Dict[str, Any], action: str, next_state: Dict[str, Any], immediate_cost: float):
       state_key = self._discretize_state(state)



        next_key = self._discretize_state(next_state)
       
       act_idx = ACTIONS.index(action)
       current_q = self.get_q_values(state_key)[act_idx]
       
       # Bound future value estimation
       next_min_q = min(self.get_q_values(next_key))
       
       # Temporal difference equation targeting the Bellman optimization minimum
       target_q = immediate_cost + self.gamma * next_min_q
       self.q_table[state_key][act_idx] += self.alpha * (target_q - current_q)


