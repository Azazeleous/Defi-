# =====================================================================
# 1. CORE CONFIGURATION & CONSTANTS
# =====================================================================
MASK32 = 0xFFFFFFFF
MASK_EVEN = 0x55555555
MASK_ODD  = 0xAAAAAAAA

ACTIONS = ["RAW", "LZ4", "ZSTD", "SNAPPY", "GZIP"]
ACTION_MAP = {idx: act for idx, act in enumerate(ACTIONS)}


# =====================================================================
# 2. ADVANCED BIDIRECTIONAL ARX STATE ENGINE
# =====================================================================
class AdvancedBidirectionalHashEngine256:
   """



    A 256-bit sequential state transformation engine executing bidirectional 32-bit ARX
   (Addition-Rotation-XOR) equations. Used as an experimental state verification layer.
   """
   def __init__(self, initial_state: List[int] = None, seed_hex: str = None):
       if seed_hex is None:
           seed_hex = "55AA55AAFF00FF00EEDDEECCBBAA99887766554433221100F0E0D0C0B0A09080"
       
       # Parse 256-bit seed into eight 32-bit slices
       seed_val = int(seed_hex, 16)
       self.r_slices = [(seed_val >> (32 * i)) & MASK32 for i in range(8)]
       
       if initial_state and len(initial_state) == 8:
           self.state = [x & MASK32 for x in initial_state]
       else:
           # Default Initialization Vectors
           base_iv = [
               0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
               0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19
           ]



            self.state = [base_iv[i] ^ self.r_slices[i] for i in range(8)]

   @staticmethod
   def rotate_left(val: int, r_bits: int) -> int:
       val &= MASK32
       return ((val << r_bits) | (val >> (32 - r_bits))) & MASK32

   @staticmethod
   def rotate_right(val: int, r_bits: int) -> int:
       val &= MASK32
       return ((val >> r_bits) | (val << (32 - r_bits))) & MASK32

   def interlace_pair(self, x: int, y: int) -> Tuple[int, int]:
       out_x = (x & MASK_EVEN) | (y & MASK_ODD)
       out_y = (y & MASK_EVEN) | (x & MASK_ODD)
       return out_x, out_y

   def deinterlace_pair(self, out_x: int, out_y: int) -> Tuple[int, int]:
       # Bijective symmetry allows direct inverse mapping



        return (out_x & MASK_EVEN) | (out_y & MASK_ODD), (out_y & MASK_EVEN) | (out_x & MASK_ODD)

   def compute_potential(self, reference_word: int, step_index: int) -> int:
       seed_modifier = self.r_slices[step_index % 8]
       potential_density = (reference_word ^ seed_modifier) + step_index
       return (potential_density * 1103515245 + 12345) & MASK32

   def apply_potential_sequence(self, forward: bool = True):
       A, B, C, D, E, F, G, H = self.state
       if forward:
           A = (A + self.compute_potential(B, 0)) & MASK32
           B = (B ^ self.compute_potential(C, 1)) & MASK32
           C = (C + self.compute_potential(D, 2)) & MASK32
           D = (D ^ self.compute_potential(E, 3)) & MASK32
           E = (E + self.compute_potential(F, 4)) & MASK32
           F = (F ^ self.compute_potential(G, 5)) & MASK32
           G = (G + self.compute_potential(H, 6)) & MASK32
           H = (H ^ self.compute_potential(A, 7)) & MASK32
       else:



            H = (H ^ self.compute_potential(A, 7)) & MASK32
           G = (G - self.compute_potential(H, 6)) & MASK32
           F = (F ^ self.compute_potential(G, 5)) & MASK32
           E = (E - self.compute_potential(F, 4)) & MASK32
           D = (D ^ self.compute_potential(E, 3)) & MASK32
           C = (C - self.compute_potential(D, 2)) & MASK32
           B = (B ^ self.compute_potential(C, 1)) & MASK32
           A = (A - self.compute_potential(B, 0)) & MASK32
       self.state = [A, B, C, D, E, F, G, H]

   def execute_forward_step(self, step_constant: int):
       A, B, C, D, E, F, G, H = self.state
       A = (A + step_constant + self.r_slices[0]) & MASK32
       B = B ^ self.rotate_left(A, 7)
       c_add = (C + B + self.r_slices[2]) & MASK32
       D = D ^ self.rotate_right(c_add, 11)
       E = (E + D + self.r_slices[4]) & MASK32
       F = F ^ self.rotate_left(E, 13)
       G = (G + F + self.r_slices[6]) & MASK32



        H = H ^ self.rotate_right(G, 17)
       
       A, B = self.interlace_pair(A, B)
       C, D = self.interlace_pair(c_add, D)
       E, F = self.interlace_pair(E, F)
       G, H = self.interlace_pair(G, H)
       
       self.state = [A, B, C, D, E, F, G, H]
       self.apply_potential_sequence(forward=True)

   def execute_backward_step(self, step_constant: int):
       self.apply_potential_sequence(forward=False)
       A, B, C, D, E, F, G, H = self.state
       
       A, B = self.deinterlace_pair(A, B)
       C, D = self.deinterlace_pair(C, D)
       E, F = self.deinterlace_pair(E, F)
       G, H = self.deinterlace_pair(G, H)
       



        H ^= self.rotate_right(G, 17)
       G = (G - F - self.r_slices[6]) & MASK32
       F ^= self.rotate_left(E, 13)
       E = (E - D - self.r_slices[4]) & MASK32
       D ^= self.rotate_right(C, 11)
       C = (C - B - self.r_slices[2]) & MASK32
       B ^= self.rotate_left(A, 7)
       A = (A - step_constant - self.r_slices[0]) & MASK32
       
       self.state = [A, B, C, D, E, F, G, H]

   def get_hex_string(self) -> str:
       return "".join(f"{word:08x}" for word in self.state)


